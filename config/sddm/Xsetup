#!/bin/sh
# Prefer connected external outputs for the SDDM greeter.
external=""
internal=""
extra=""

for out in $(xrandr --query 2>/dev/null | awk '/ connected/ {print $1}'); do
    case "$out" in
        eDP*|LVDS*|DSI*)
            internal="$out"
            ;;
        *)
            if [ -z "$external" ]; then
                external="$out"
            else
                extra="$extra $out"
            fi
            ;;
    esac
done

if [ -n "$external" ]; then
    xrandr --output "$external" --auto --primary
    for out in $extra; do
        xrandr --output "$out" --auto --same-as "$external"
    done
    [ -n "$internal" ] && xrandr --output "$internal" --off
fi

exit 0
