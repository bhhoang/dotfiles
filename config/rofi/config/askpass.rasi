@import "colors.rasi"
@import "font.rasi"

* {
    background-color:       @BG;
    text-color:             @FG;
}

window {
    width:                  280px;
    padding:                20px;
    border:                 1px;
    border-radius:          14px;
    border-color:           @BDR;
    location:               0;
    x-offset:               0;
    y-offset:               -4%;
}

entry {
    expand:                 true;
    width:                  180px;
    text-color:             @FG;
}
