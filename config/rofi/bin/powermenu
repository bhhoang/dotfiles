#!/usr/bin/env bash
# Power menu — glass rofi theme (icons + labels, with Yes/No confirmation).

rofi_command="rofi -theme $HOME/.config/rofi/config/powermenu.rasi"
ddir="$HOME/.config/rofi/config"

# Material Design icons (kept as \U escapes so the file stays ASCII-safe).
shutdown=$'\U000f0425  Shutdown'
reboot=$'\U000f0709  Restart'
lock=$'\U000f033e  Lock'
suspend=$'\U000f03e5  Sleep'
logout=$'\U000f0343  Logout'

lock_screen() {
    swaylock --indicator-radius 160 -c 000000 \
        --ring-color b4befe --ring-ver-color b4befe --key-hl-color 000000 \
        --inside-color b4befe --inside-ver-color b4befe --inside-clear-color a6e3a1 \
        --ring-clear-color a6e3a1 --ring-wrong-color f38ba8 --inside-wrong-color f38ba8 \
        --bs-hl-color f38ba8 --text-caps-lock-color 000000
}

rdialog() {
    printf 'Yes\nNo\n' | rofi -dmenu -i -p "Are you sure?" -theme "$ddir/confirm.rasi" -selected-row 0
}

show_msg() {
    rofi -theme "$ddir/askpass.rasi" -e "Options: yes / no / y / n"
}

is_yes() { [[ "$1" == "Yes" || "$1" == "yes" || "$1" == "YES" || "$1" == "y" ]]; }
is_no()  { [[ "$1" == "No"  || "$1" == "no"  || "$1" == "NO"  || "$1" == "n" ]]; }

options="$lock\n$suspend\n$logout\n$reboot\n$shutdown"
chosen="$(echo -e "$options" | $rofi_command -dmenu -selected-row 0)"

case "$chosen" in
    "$lock")
        lock_screen
        ;;
    "$suspend")
        ans=$(rdialog)
        if is_yes "$ans"; then
            lock_screen
            systemctl suspend
        elif is_no "$ans"; then
            exit 0
        else
            show_msg
        fi
        ;;
    "$logout")
        ans=$(rdialog)
        if is_yes "$ans"; then
            loginctl terminate-user "$USER"
        elif is_no "$ans"; then
            exit 0
        else
            show_msg
        fi
        ;;
    "$reboot")
        ans=$(rdialog)
        if is_yes "$ans"; then
            systemctl reboot
        elif is_no "$ans"; then
            exit 0
        else
            show_msg
        fi
        ;;
    "$shutdown")
        ans=$(rdialog)
        if is_yes "$ans"; then
            systemctl poweroff
        elif is_no "$ans"; then
            exit 0
        else
            show_msg
        fi
        ;;
esac
