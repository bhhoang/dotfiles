/* ─────────────────────────────────────────────────────────────────────────
   Rofi — glass theme
   Matches ~/.config/waybar/style.css (floating translucent slab, lavender
   accent, rounded corners). Hyprland blurs the translucent rofi window.
   ───────────────────────────────────────────────────────────────────────── */

* {
    font: "Roboto 14";
    background-color: transparent;
    text-color: #cdd6f4;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    transparency: "real";
    location: center;
    width: 640px;
    padding: 12px;
    background-color: #1e2030cc;
    border: 1px;
    border-color: #ffffff26;
    border-radius: 18px;
}

mainbox {
    background-color: transparent;
    spacing: 10px;
    padding: 4px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: #ffffff12;
    text-color: #cdd6f4;
    border: 1px;
    border-color: #ffffff1f;
    border-radius: 12px;
    padding: 10px 14px;
    spacing: 10px;
}

prompt {
    background-color: transparent;
    text-color: #b4befe;
    padding: 0;
}

textbox-prompt-colon {
    expand: false;
    str: "";
    background-color: transparent;
    text-color: #b4befe;
    margin: 0;
}

entry {
    background-color: transparent;
    text-color: #cdd6f4;
    placeholder-color: #6c7086;
    placeholder: "Search…";
    cursor: text;
    expand: true;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 10;
    spacing: 4px;
    scrollbar: false;
    dynamic: true;
    cycle: true;
    layout: vertical;
}

element {
    background-color: transparent;
    text-color: #cdd6f4;
    border-radius: 10px;
    padding: 8px 12px;
    spacing: 10px;
    orientation: horizontal;
}

element-icon {
    background-color: transparent;
    size: 22px;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

element selected {
    background-color: #b4befe;
    text-color: #11111b;
    border-radius: 10px;
}

element urgent,
element selected urgent {
    background-color: #f38ba8;
    text-color: #11111b;
}

element active {
    background-color: #a6e3a1;
    text-color: #11111b;
}

scrollbar {
    background-color: transparent;
    handle-color: #b4befe66;
    width: 4px;
    border-radius: 2px;
}

mode-switcher {
    background-color: transparent;
    spacing: 6px;
}

button {
    background-color: #ffffff12;
    text-color: #cdd6f4;
    border: 1px;
    border-color: #ffffff1f;
    border-radius: 10px;
    padding: 6px 12px;
}

button selected {
    background-color: #b4befe;
    text-color: #11111b;
}

message {
    background-color: #f38ba81f;
    text-color: #f38ba8;
    border-radius: 10px;
    padding: 8px 12px;
}

textbox {
    background-color: transparent;
    text-color: #cdd6f4;
}

case-indicator {
    background-color: transparent;
    text-color: #6c7086;
    spacing: 4px;
}

sidebar {
    background-color: transparent;
    spacing: 8px;
}

menu {
    background-color: transparent;
    spacing: 4px;
}

dummy {
    expand: true;
}
